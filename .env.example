# Copy to .env or export these in your shell. Never commit a file with real values.
# The program reads the process environment; it does not load .env files by itself,
# so use `export $(grep -v '^#' .env | xargs)` or your shell's own mechanism.

# Optional. Without a key, every feature except `logan explain` still works.
ANTHROPIC_API_KEY=

# Required when a key is set. Use a model name from Anthropic's documentation.
# It is not built in, because model names change over time.
ANTHROPIC_MODEL=

# Optional. Where the SQLite database lives. Default: ./log_analyzer.db
LOG_ANALYZER_DB=log_analyzer.db

# Optional. Seconds to wait for the language-model service. Default: 30
LOG_ANALYZER_LLM_TIMEOUT=30
